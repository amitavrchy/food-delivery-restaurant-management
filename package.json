{
  "name": "tablelane", "version": "1.0.0", "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "infra": "docker compose up -d postgres redis",
    "test:e2e": "playwright test"
  },
  "devDependencies": {"concurrently": "^9.2.1", "@playwright/test": "^1.56.1", "typescript": "^5.9.3"}
}
