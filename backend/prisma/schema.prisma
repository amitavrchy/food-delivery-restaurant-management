generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role String @default("CUSTOMER")
  createdAt DateTime @default(now())
  memberships UserRestaurantRole[]
  orders Order[]
  rider RiderProfile?
  shifts Shift[]
  organizations Organization[]
  addresses CustomerAddress[]
  favorites FavoriteRestaurant[]
  loyaltyEntries LoyaltyEntry[]
  notifications Notification[]
  reservations Reservation[]
  scheduledShifts ScheduledShift[]
  leaveRequests LeaveRequest[]
  supportTickets SupportTicket[]
  supportMessages SupportMessage[]
}
model UserRestaurantRole {
  id String @id @default(cuid())
  userId String
  restaurantId String
  role String
  hourlyRateMinor Int @default(0)
  user User @relation(fields:[userId], references:[id])
  restaurant Restaurant @relation(fields:[restaurantId], references:[id])
  @@unique([userId,restaurantId,role])
}
model Restaurant {
  id String @id @default(cuid())
  name String
  slug String @unique
  cuisine String
  description String
  image String
  address String
  status String @default("ACTIVE")
  lat Float
  lng Float
  timezone String @default("Asia/Dhaka")
  autoAccept Boolean @default(false)
  isOnline Boolean @default(true)
  commissionBps Int @default(1500)
  deliveryFeeMinor Int @default(4900)
  organizationId String?
  taxBps Int @default(500)
  serviceBps Int @default(500)
  minOrderMinor Int @default(0)
  deliveryRadiusKm Float @default(15)
  loyaltyEnabled Boolean @default(true)
  openingHours Json @default("{}")
  organization Organization? @relation(fields:[organizationId],references:[id])
  favorites FavoriteRestaurant[]
  reservations Reservation[]
  waitlist WaitlistEntry[]
  suppliers Supplier[]
  purchaseOrders PurchaseOrder[]
  invites StaffInvite[]
  plannedShifts ScheduledShift[]
  leaveRequests LeaveRequest[]
  promotions PromoCode[]
  supportTickets SupportTicket[]
  categories MenuCategory[]
  items MenuItem[]
  stations PrepStation[]
  inventory InventoryItem[]
  tables DiningTable[]
  staff UserRestaurantRole[]
  orders Order[]
  shifts Shift[]
}
model MenuCategory {
  id String @id @default(cuid())
  restaurantId String
  name String
  sort Int @default(0)
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
  items MenuItem[]
}
model MenuItem {
  id String @id @default(cuid())
  restaurantId String
  categoryId String
  stationId String
  name String
  description String
  image String
  priceMinor Int
  isAvailable Boolean @default(true)
  archived Boolean @default(false)
  prepMinutes Int @default(15)
  availableFrom Int @default(0)
  availableUntil Int @default(24)
  dietaryTags String[] @default([])
  allergens String[] @default([])
  energyKcal Int?
  featured Boolean @default(false)
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
  category MenuCategory @relation(fields:[categoryId],references:[id])
  station PrepStation @relation(fields:[stationId],references:[id])
  modifierGroups ModifierGroup[]
  recipe RecipeComponent[]
  lines OrderLine[]
}
model ModifierGroup {
  id String @id @default(cuid())
  menuItemId String
  name String
  minSelect Int @default(0)
  maxSelect Int @default(1)
  item MenuItem @relation(fields:[menuItemId],references:[id])
  options ModifierOption[]
}
model ModifierOption {
  id String @id @default(cuid())
  groupId String
  name String
  priceDeltaMinor Int @default(0)
  inventoryItemId String?
  ingredientQty Decimal @default(0) @db.Decimal(14,3)
  group ModifierGroup @relation(fields:[groupId],references:[id])
}
model RecipeComponent {
  id String @id @default(cuid())
  menuItemId String
  inventoryItemId String
  qty Decimal @db.Decimal(14,3)
  item MenuItem @relation(fields:[menuItemId],references:[id])
  ingredient InventoryItem @relation(fields:[inventoryItemId],references:[id])
  @@unique([menuItemId,inventoryItemId])
}
model InventoryItem {
  id String @id @default(cuid())
  restaurantId String
  name String
  uom String
  qtyOnHand Decimal @db.Decimal(14,3)
  lowStockQty Decimal @db.Decimal(14,3)
  costMinor Int @default(0)
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
  components RecipeComponent[]
  movements StockMovement[]
  purchaseLines PurchaseOrderLine[]
  transfersOut StockTransfer[] @relation("StockFrom")
  transfersIn StockTransfer[] @relation("StockTo")
}
model StockMovement {
  id String @id @default(cuid())
  inventoryItemId String
  delta Decimal @db.Decimal(14,3)
  reason String
  reference String?
  byUserId String
  createdAt DateTime @default(now())
  item InventoryItem @relation(fields:[inventoryItemId],references:[id])
}
model PrepStation {
  id String @id @default(cuid())
  restaurantId String
  name String
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
  items MenuItem[]
  tickets KitchenTicket[]
}
model DiningTable {
  id String @id @default(cuid())
  restaurantId String
  code String
  seats Int
  posX Float @default(0)
  posY Float @default(0)
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
  checks TableCheck[]
  reservations Reservation[]
  @@unique([restaurantId,code])
}
model TableCheck {
  id String @id @default(cuid())
  tableId String
  status String @default("OPEN")
  openedAt DateTime @default(now())
  closedAt DateTime?
  table DiningTable @relation(fields:[tableId],references:[id])
  orders Order[]
  payments CheckPayment[]
}
model CheckPayment {
  id String @id @default(cuid())
  checkId String
  amountMinor Int
  method String
  seat Int?
  lineId String?
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  check TableCheck @relation(fields:[checkId],references:[id])
}
model Order {
  id String @id @default(cuid())
  number Int @unique @default(autoincrement())
  restaurantId String
  customerId String
  channel String
  status String @default("PLACED")
  tableCheckId String?
  riderId String?
  goodsMinor Int
  deliveryFeeMinor Int @default(0)
  discountMinor Int @default(0)
  taxMinor Int @default(0)
  tipMinor Int @default(0)
  serviceMinor Int @default(0)
  grandMinor Int
  deliveryAddress String?
  deliveryPhone String?
  dropLat Float?
  dropLng Float?
  notes String @default("")
  cancelReason String?
  penaltyMinor Int @default(0)
  otpHash String?
  idempotencyKey String @unique
  placedAt DateTime @default(now())
  scheduledFor DateTime?
  loyaltyRedeemed Int @default(0)
  loyaltyEarned Int @default(0)
  loyaltyEntries LoyaltyEntry[]
  promoRedemption PromoRedemption?
  supportTickets SupportTicket[]
  proofs DeliveryProof[]
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
  customer User @relation(fields:[customerId],references:[id])
  rider RiderProfile? @relation(fields:[riderId],references:[userId])
  check TableCheck? @relation(fields:[tableCheckId],references:[id])
  lines OrderLine[]
  history OrderStatusHistory[]
  tickets KitchenTicket[]
  offers RiderOffer[]
  payments Payment[]
  rating Rating?
  @@index([restaurantId,status])
  @@index([customerId,placedAt])
  @@index([riderId,status])
}
model OrderLine {
  id String @id @default(cuid())
  orderId String
  menuItemId String
  nameSnapshot String
  qty Int
  unitPriceMinor Int
  seat Int @default(1)
  course String @default("MAIN")
  modifiers Json
  order Order @relation(fields:[orderId],references:[id])
  item MenuItem @relation(fields:[menuItemId],references:[id])
}
model OrderStatusHistory {
  id String @id @default(cuid())
  orderId String
  fromStatus String?
  toStatus String
  at DateTime @default(now())
  byUserId String
  reason String?
  order Order @relation(fields:[orderId],references:[id])
}
model KitchenTicket {
  id String @id @default(cuid())
  orderId String
  stationId String
  status String @default("QUEUED")
  items Json
  course String @default("MAIN")
  fireAt DateTime @default(now())
  doneAt DateTime?
  inventoryDeducted Boolean @default(false)
  order Order @relation(fields:[orderId],references:[id])
  station PrepStation @relation(fields:[stationId],references:[id])
  @@index([stationId,status])
}
model RiderProfile {
  userId String @id
  status String @default("OFFLINE")
  lat Float?
  lng Float?
  vehicle String @default("Bicycle")
  documentRef String?
  verified Boolean @default(false)
  ratingAvg Float @default(4.8)
  capacity Int @default(2)
  lastPingAt DateTime?
  user User @relation(fields:[userId],references:[id])
  orders Order[]
  offers RiderOffer[]
  pings RiderLocationPing[]
}
model RiderOffer {
  id String @id @default(cuid())
  orderId String
  riderId String
  status String @default("SENT")
  expiresAt DateTime
  order Order @relation(fields:[orderId],references:[id])
  rider RiderProfile @relation(fields:[riderId],references:[userId])
  @@index([orderId,status])
  @@index([riderId,status])
}
model RiderLocationPing {
  id String @id @default(cuid())
  riderId String
  lat Float
  lng Float
  at DateTime @default(now())
  rider RiderProfile @relation(fields:[riderId],references:[userId])
  @@index([riderId,at])
}
model Payment {
  id String @id @default(cuid())
  orderId String
  provider String
  status String @default("PENDING")
  amountMinor Int
  providerReference String? @unique
  checkoutUrl String?
  paymentIntentId String?
  refunds PaymentRefund[]
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId],references:[id])
}
model PaymentRefund {
  id String @id @default(cuid())
  paymentId String
  amountMinor Int
  status String @default("REQUESTED")
  providerReference String? @unique
  idempotencyKey String @unique
  reason String
  requestedById String
  createdAt DateTime @default(now())
  payment Payment @relation(fields:[paymentId],references:[id],onDelete:Cascade)
}
model PaymentEvent {
  id String @id
  provider String
  createdAt DateTime @default(now())
}
model Shift {
  id String @id @default(cuid())
  restaurantId String
  userId String
  startedAt DateTime @default(now())
  endedAt DateTime?
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
  user User @relation(fields:[userId],references:[id])
}
model PromoCode {
  id String @id @default(cuid())
  code String @unique
  type String
  value Int
  minOrderMinor Int @default(0)
  maxDiscountMinor Int @default(100000)
  active Boolean @default(true)
  expiresAt DateTime?
  startsAt DateTime?
  restaurantId String?
  maxRedemptions Int @default(10000)
  maxPerCustomer Int @default(1)
  restaurant Restaurant? @relation(fields:[restaurantId],references:[id])
  redemptions PromoRedemption[]
}
model Rating {
  id String @id @default(cuid())
  orderId String @unique
  stars Int
  comment String
  riderStars Int?
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId],references:[id])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  entityId String
  detail Json
  createdAt DateTime @default(now())
}

model Organization {
  id String @id @default(cuid())
  name String
  ownerId String
  createdAt DateTime @default(now())
  owner User @relation(fields:[ownerId],references:[id])
  restaurants Restaurant[]
}
model CustomerAddress {
  id String @id @default(cuid())
  userId String
  label String
  address String
  phone String
  lat Float?
  lng Float?
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  @@index([userId])
}
model FavoriteRestaurant {
  id String @id @default(cuid())
  userId String
  restaurantId String
  user User @relation(fields:[userId],references:[id])
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
  @@unique([userId,restaurantId])
}
model LoyaltyEntry {
  id String @id @default(cuid())
  userId String
  orderId String?
  points Int
  kind String
  reason String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  order Order? @relation(fields:[orderId],references:[id],onDelete:Cascade)
  @@unique([orderId,kind])
  @@index([userId,createdAt])
}
model Notification {
  id String @id @default(cuid())
  userId String
  kind String
  title String
  body String
  href String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  @@index([userId,readAt,createdAt])
}
model Reservation {
  id String @id @default(cuid())
  restaurantId String
  userId String?
  tableId String?
  guestName String
  phone String
  partySize Int
  startsAt DateTime
  endsAt DateTime
  status String @default("BOOKED")
  notes String @default("")
  createdAt DateTime @default(now())
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
  user User? @relation(fields:[userId],references:[id])
  table DiningTable? @relation(fields:[tableId],references:[id])
  @@index([restaurantId,startsAt,status])
}
model WaitlistEntry {
  id String @id @default(cuid())
  restaurantId String
  guestName String
  phone String
  partySize Int
  quotedMinutes Int @default(15)
  status String @default("WAITING")
  notes String @default("")
  createdAt DateTime @default(now())
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
  @@index([restaurantId,status,createdAt])
}
model Supplier {
  id String @id @default(cuid())
  restaurantId String
  name String
  email String?
  phone String
  leadDays Int @default(1)
  active Boolean @default(true)
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
  orders PurchaseOrder[]
}
model PurchaseOrder {
  id String @id @default(cuid())
  restaurantId String
  supplierId String
  status String @default("DRAFT")
  expectedAt DateTime?
  notes String @default("")
  createdById String
  createdAt DateTime @default(now())
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
  supplier Supplier @relation(fields:[supplierId],references:[id])
  lines PurchaseOrderLine[]
  receipts StockReceipt[]
}
model PurchaseOrderLine {
  id String @id @default(cuid())
  purchaseOrderId String
  inventoryItemId String
  orderedQty Decimal @db.Decimal(14,3)
  receivedQty Decimal @default(0) @db.Decimal(14,3)
  unitCostMinor Int
  order PurchaseOrder @relation(fields:[purchaseOrderId],references:[id])
  ingredient InventoryItem @relation(fields:[inventoryItemId],references:[id])
}
model StockReceipt {
  id String @id @default(cuid())
  purchaseOrderId String
  idempotencyKey String @unique
  invoiceReference String
  lines Json
  byUserId String
  createdAt DateTime @default(now())
  order PurchaseOrder @relation(fields:[purchaseOrderId],references:[id])
}
model StockTransfer {
  id String @id @default(cuid())
  sourceItemId String
  targetItemId String
  qty Decimal @db.Decimal(14,3)
  reason String
  byUserId String
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  source InventoryItem @relation("StockFrom",fields:[sourceItemId],references:[id])
  target InventoryItem @relation("StockTo",fields:[targetItemId],references:[id])
}
model StaffInvite {
  id String @id @default(cuid())
  restaurantId String
  email String
  role String
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
}
model ScheduledShift {
  id String @id @default(cuid())
  restaurantId String
  userId String
  startsAt DateTime
  endsAt DateTime
  role String
  hourlyRateMinor Int @default(0)
  notes String @default("")
  status String @default("PLANNED")
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
  user User @relation(fields:[userId],references:[id])
  @@index([restaurantId,startsAt])
}
model LeaveRequest {
  id String @id @default(cuid())
  restaurantId String
  userId String
  startsAt DateTime
  endsAt DateTime
  reason String
  status String @default("PENDING")
  reviewedById String?
  createdAt DateTime @default(now())
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
  user User @relation(fields:[userId],references:[id])
}
model PromoRedemption {
  id String @id @default(cuid())
  promoId String
  orderId String @unique
  customerId String
  discountMinor Int
  createdAt DateTime @default(now())
  promo PromoCode @relation(fields:[promoId],references:[id])
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  @@index([promoId,customerId])
}
model SupportTicket {
  id String @id @default(cuid())
  restaurantId String
  orderId String
  userId String
  category String
  subject String
  status String @default("OPEN")
  refundMinor Int @default(0)
  refundReference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  restaurant Restaurant @relation(fields:[restaurantId],references:[id])
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id])
  messages SupportMessage[]
}
model SupportMessage {
  id String @id @default(cuid())
  ticketId String
  authorId String
  body String
  createdAt DateTime @default(now())
  ticket SupportTicket @relation(fields:[ticketId],references:[id],onDelete:Cascade)
  author User @relation(fields:[authorId],references:[id])
}
model DeliveryProof {
  id String @id @default(cuid())
  orderId String
  riderId String
  storageKey String
  mimeType String
  sha256 String
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
}
