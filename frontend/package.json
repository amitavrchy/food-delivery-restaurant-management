{
  "name": "@tablelane/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node init && next dev",
    "build": "node init && next build --webpack",
    "start": "node init && next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts",
    "format:check": "prettier --check src tests *.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.552.0",
    "next": "^16.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3",
    "@playwright/test": "^1.65.0",
    "prettier": "^3.8.0"
  }
}
